# URL base de la API pública de la tienda (subdominio del tenant, sin barra final).
# Se llama directo al subdominio (sin header X-Tenant) para evitar preflights CORS.
VITE_API_BASE_URL=https://monatekeda.app.noinventes.com/api/store

# Datos de la tienda (temporales hasta que exista GET /api/store/info)
VITE_STORE_NAME=Monatekeda
VITE_STORE_TAGLINE=Artesanía y souvenirs peruanos
# Número en formato internacional sin "+" ni espacios (ej. 51987654321)
VITE_WHATSAPP_NUMBER=51999999999
